# shellcheck shell=sh
# Desktop profile — sway workstation.
# Sourced from ~/.profile via the ~/.profile.local symlink.

# Resilio Sync, desktop-only. Skipped harmlessly if the directory doesn't
# exist (e.g. Resilio Sync not installed yet).
if [ -d "$HOME/jamie-sync/bin" ]; then
  case ":$PATH:" in
  *":$HOME/jamie-sync/bin:"*) ;; # already present, don't duplicate
  *) export PATH="$PATH:$HOME/jamie-sync/bin" ;;
  esac
fi

# Start Sway on tty1 if we're not already in a Wayland session.
# `touch ~/.no-sway` disables this without editing the repo.
if [ -z "${WAYLAND_DISPLAY:-}" ] &&
  [ "${XDG_VTNR:-}" = 1 ] &&
  [ ! -f "$HOME/.no-sway" ]; then
  # Log to a file rather than tty1 so crash output survives a re-login.
  # The previous session's log is kept as sway.log.old.
  sway_log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sway"
  mkdir -p "$sway_log_dir"
  [ -f "$sway_log_dir/sway.log" ] &&
    mv -f "$sway_log_dir/sway.log" "$sway_log_dir/sway.log.old"
  exec sway >"$sway_log_dir/sway.log" 2>&1
fi
