# ~/.config/sway/config.common
# Shared across all hosts. Edit here, then `git pull` on the other machine.
# Host-specific bits (outputs, touchpad, lid, idle/power) live in
# config.d/<hostname>.conf and are included by each machine's thin
# ~/.config/sway/config.

set $alt Mod1
set $mod Mod4

font pango:JetBrainsMono Nerd Font 10

# --- Autostart -----------------------------------------------------------
exec dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

exec --no-startup-id dex --autostart --environment sway

# Using mako instead of dunst (Wayland-native, no XWayland dependency).
exec --no-startup-id mako

exec --no-startup-id nm-applet --indicator

# --- Audio -----------------------------------------------------------------
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# --- Brightness --------------------------------------------------------
# No-op on the Meerkat (no /sys/class/backlight for external HDMI monitors),
# functional on the P14. Harmless to keep in the shared file.
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl --min-val=2 -q set 5%-
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl -q set 5%+

# --- Screenshots -------------------------------------------------------
bindsym Print exec --no-startup-id grim -g "$(slurp -d)" - | swappy -f -
bindsym Shift+Print exec --no-startup-id grim -o "$(swaymsg -t get_outputs --raw | jq -r '.[] | select(.focused).name')" - | swappy -f -
bindsym Ctrl+Print exec --no-startup-id grim -g "$(slurp)" - | wl-copy

# --- Window management --------------------------------------------------
floating_modifier $mod normal
tiling_drag enable

bindsym $mod+Return exec sh -c 'd="$(swaycwd 2>/dev/null)"; [ -d "$d" ] || d="$HOME"; foot -D "$d"'

bindsym $mod+Shift+q kill
bindsym $mod+q kill

bindsym $mod+shift+d exec --no-startup-id wmenu-run
bindsym $mod+space exec --no-startup-id wofi --show drun

bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

bindsym $mod+h split h
bindsym $mod+v split v

bindsym $mod+Shift+f fullscreen toggle

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+a focus parent

# --- Workspaces (numbered) -----------------------------------------------
# Which output each lands on by default is host-specific (see config.d/),
# but the bindings themselves are identical everywhere.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Tab workspace back_and_forth

# --- Session -------------------------------------------------------------
bindsym $mod+Shift+r reload
bindsym $mod+Shift+e exec swaynag -t warning \
    -m 'Exit sway?' -B 'Yes, exit sway' 'swaymsg exit'

mode "resize" {
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# --- Appearance ------------------------------------------------------------
gaps inner 10
gaps outer 5
smart_gaps on

default_border pixel 2
default_floating_border pixel 2

# --- Input: keyboard ------------------------------------------------------
# Same layout/repeat rate on both machines. Touchpad settings are
# P14-only and live in config.d/p14.conf.
input type:keyboard {
    xkb_layout us
    repeat_delay 300
    repeat_rate 50
}

# --- Scratchpad & apps ----------------------------------------------------
bindsym $mod+minus scratchpad show

bindsym $mod+f exec thunar
for_window [app_id="thunar"] move scratchpad, scratchpad show

bindsym $mod+x exec geany
for_window [app_id="geany"] move scratchpad, scratchpad show

bindsym Control+$alt+l exec swaylock -c 000000

bindsym $mod+F1 exec "grep -E '^bindsym' ~/.config/sway/config.common | wmenu -i -l 20"

# --- Zoom ------------------------------------------------------------------
for_window [class="zoom" title="annotate_toolbar"] move to workspace number 99
for_window [app_id="zoom" title="annotate_toolbar"] move to workspace number 99
