[Desktop Entry]
Name=Slack
StartupWMClass=Slack
Comment=Slack Desktop
GenericName=Slack Client for Linux
# --ozone-platform=x11 runs Slack under XWayland instead of native Wayland,
# to test whether Slack triggers the wlroots texture-box assertion that has
# been aborting sway (docs/desktop-notes.md, "Debugging sway crashes").
# Drop it to go back to native Wayland.
Exec=/usr/bin/slack --ozone-platform=x11 --enable-features=WebRTCPipeWireCapturer %U
Icon=/usr/share/pixmaps/slack.png
Type=Application
StartupNotify=true
Categories=GNOME;GTK;Network;InstantMessaging;
MimeType=x-scheme-handler/slack;
